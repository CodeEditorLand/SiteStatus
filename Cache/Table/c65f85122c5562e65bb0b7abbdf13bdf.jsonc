			],
			"Message": "style(Wind): Use POSIX sh shebang for build scripts\n\nUpdate the shebang line in both Source/Run.sh and Source/prepublishOnly.sh from `#!/usr/bin/env bash` to `#!/usr/bin/env sh` for improved portability across Unix-like systems.\n\nThis ensures the build scripts can execute on systems where bash may not be installed or available at the standard path, adhering to POSIX compatibility standards.",
			"SHA": "2c942308aa79bd450545ad2868729a8dc4dac8aa"
		},
