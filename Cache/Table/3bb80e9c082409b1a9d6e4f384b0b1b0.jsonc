// CACHE: GET /repos/{owner}/{repo}/commits | owner=CodeEditorLand | repo=Cocoon | per_page=5 | page=12 → GET /repos/{owner}/{repo}/commits.RESPONSE.map(Author,Date,File,Message,SHA)
{
	"Set": [
		{
			"Author": "Nikola Hristov",
