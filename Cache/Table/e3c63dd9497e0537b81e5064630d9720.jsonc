// CACHE: GET /repos/{owner}/{repo}/commits | owner=CodeEditorLand | repo=Wind | per_page=5 | page=43 → GET /repos/{owner}/{repo}/commits.RESPONSE.map(Author,Date,File,Message,SHA)
{
	"Set": [
		{
			"Author": "Nikola Hristov",
