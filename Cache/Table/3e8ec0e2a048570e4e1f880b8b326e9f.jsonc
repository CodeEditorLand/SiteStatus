			"Message": "Merge branch 'Current' of ssh://github.com/CodeEditorLand/Element into Current",
			"SHA": "f5d5bc312951641e02cc2ddcc0cde597bf3dcdbb"
		},
		{
			"Author": "Nikola Hristov",
			"Date": "2026-01-30T10:21:41Z",
