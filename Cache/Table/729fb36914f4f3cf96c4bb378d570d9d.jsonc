// CACHE: GET /repos/{owner}/{repo}/commits | owner=CodeEditorLand | repo=Vine | per_page=5 | page=20 → GET /repos/{owner}/{repo}/commits.RESPONSE.map(Author,Date,File,Message,SHA)
{
	"Set": [
		{
			"Author": "Nikola Hristov",
