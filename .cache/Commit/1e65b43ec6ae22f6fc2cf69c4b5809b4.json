				"patch": "@@ -0,0 +1,15 @@\n+# 🌊 [River] —\n+\n+## Installation\n+\n+## Usage\n+\n+## Dependencies\n+\n+The code imports several crates:\n+\n+[River]: HTTPS://github.com/CodeEditorLand/River\n+\n+## Changelog\n+\n+See [CHANGELOG.md](CHANGELOG.md) for a history of changes to this CLI."
			},
			{
				"sha": "ba2c2ab0b489d6785fbe1be8279626856f59b1ad",
				"filename": "Source/Library.rs",
				"status": "added",
				"additions": 54,
				"deletions": 0,
				"changes": 54,
				"blob_url": "https://github.com/CodeEditorLand/River/blob/d687d1c37ed41d4968a4892947c0e9f3c34fd4ca/Source%2FLibrary.rs",
				"raw_url": "https://github.com/CodeEditorLand/River/raw/d687d1c37ed41d4968a4892947c0e9f3c34fd4ca/Source%2FLibrary.rs",
				"contents_url": "https://api.github.com/repos/CodeEditorLand/River/contents/Source%2FLibrary.rs?ref=d687d1c37ed41d4968a4892947c0e9f3c34fd4ca",
				"patch": "@@ -0,0 +1,54 @@\n+// src/bin/file_reader.rs\n+use dashmap::DashMap;\n+use serde::{Deserialize, Serialize};\n+use std::sync::Arc;\n+use tokio::{fs::File, io::AsyncReadExt, net::TcpListener};\n+use tokio_tungstenite::{accept_async, tungstenite::Message};\n+\n+#[derive(Serialize, Deserialize)]\n+struct FileRequest {\n+\tpath: String,\n+}\n+\n+#[derive(Serialize, Deserialize)]\n+struct FileResponse {\n+\tpath: String,\n+\tcontent: String,\n+}\n+\n+#[tokio::main]\n+async fn main() {\n+\tlet cache = Arc::new(DashMap::new());\n+\tlet listener = TcpListener::bind(\"127.0.0.1:9999\").await.unwrap();\n+\n+\twhile let Ok((stream, _)) = listener.accept().await {\n+\t\tlet cache = cache.clone();\n+\t\ttokio::spawn(handle_connection(stream, cache));\n+\t}\n+}\n+\n+async fn handle_connection(stream: tokio::net::TcpStream, cache: Arc<DashMap<String, String>>) {\n+\tlet ws_stream = accept_async(stream).await.unwrap();\n+\tlet (write, read) = ws_stream.split();\n+\n+\tread.for_each(|message| async {\n+\t\tif let Ok(msg) = message {\n+\t\t\tif msg.is_text() {\n+\t\t\t\tlet file_request: FileRequest =\n+\t\t\t\t\tserde_json::from_str(msg.to_text().unwrap()).unwrap();\n+\t\t\t\tlet response = if let Some(content) = cache.get(&file_request.path) {\n+\t\t\t\t\tFileResponse { path: file_request.path.clone(), content: content.clone() }\n+\t\t\t\t} else {\n+\t\t\t\t\tlet mut file = File::open(&file_request.path).await.unwrap();\n+\t\t\t\t\tlet mut content = String::new();\n+\t\t\t\t\tfile.read_to_string(&mut content).await.unwrap();\n+\t\t\t\t\tcache.insert(file_request.path.clone(), content.clone());\n+\t\t\t\t\tFileResponse { path: file_request.path, content }\n+\t\t\t\t};\n+\t\t\t\tlet response_msg = Message::text(serde_json::to_string(&response).unwrap());\n+\t\t\t\twrite.send(response_msg).await.unwrap();\n+\t\t\t}\n+\t\t}\n+\t})\n+\t.await;\n+}"
			}
		]
