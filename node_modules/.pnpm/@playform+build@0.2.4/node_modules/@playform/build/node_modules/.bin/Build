#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/Target/Class/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/Target/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/Target/Class/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/Target/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/build/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules/@playform/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/@playform+build@0.2.4/node_modules:/home/runner/work/StatusCodeEditorLandWebSite/StatusCodeEditorLandWebSite/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../Target/Class/Build.js" "$@"
else
  exec node  "$basedir/../../Target/Class/Build.js" "$@"
fi
