---
interface Props {
	Key: string;
	Title?: string;
	Height?: number;
}

const { Key, Title, Height = 400 } = Astro.props;

const Source = `https://eu.posthog.com/embedded/${Key}`;
const Share = `https://eu.posthog.com/shared/${Key}`;
---

<div class="m-2 p-2">
	{Title && (
		<div class="Analytic-Header">
			<h2 class="Analytic-Title">{Title}</h2>
			<a
				href={Share}
				target="_blank"
				rel="noopener noreferrer"
				title={`Open ${Title} in PostHog`}
				class="Analytic-Link"
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
					<polyline points="15 3 21 3 21 9" />
					<line x1="10" y1="14" x2="21" y2="3" />
				</svg>
			</a>
		</div>
	)}
	<iframe
		width="100%"
		height={Height}
		frameborder="0"
		allowfullscreen
		src={Source}
		sandbox="allow-scripts allow-same-origin allow-popups"
		loading="lazy"
		title={Title ?? `PostHog analytic ${Key}`}
		style="padding: 3px; background-color: #f2f4f0;"
	></iframe>
</div>

<style>
	.Analytic-Header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.Analytic-Title {
		flex: 1;
	}

	.Analytic-Link {
		display: inline-flex;
		align-items: center;
		opacity: 0.6;
		transition: opacity 180ms ease;
	}

	.Analytic-Link:hover {
		opacity: 1;
	}
</style>
