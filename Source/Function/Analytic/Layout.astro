---
interface Props {
	Key: string;
	Title?: string;
	Height?: number;
}

const { Key, Title, Height = 400 } = Astro.props;

const Source = `https://eu.posthog.com/embedded/${Key}`;
---

<div class="m-2 p-2">
	{Title && <h2 class="Analytic-Title">{Title}</h2>}
	<iframe
		width="100%"
		height={Height}
		frameborder="0"
		allowfullscreen
		src={Source}
		sandbox="allow-scripts allow-same-origin allow-popups"
		loading="lazy"
		title={Title ?? `PostHog analytic ${Key}`}
		style="padding: 3px; background-color: #f2f4f0;"
	></iframe>
</div>

<style>
	.Analytic-Title {
		margin-bottom: 0.5rem;
	}
</style>
