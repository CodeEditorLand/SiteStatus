---
import type { CF_PAGES_COMMIT_SHA } from "astro:env/server";

export const On = process.env["NODE_ENV"] === "development";

const SHA = (await import("astro:env/server")).getSecret(
	"CF_PAGES_COMMIT_SHA",
) as typeof CF_PAGES_COMMIT_SHA;

const { default: Request } = await import("@Function/Table/Layout/Request.js");

const { User, Repository } = Astro.props;

const Dot = async (Total: number, File: number) =>
	new (await import("@Function/Table/Layout/Dot.js")).default({
		Total,
	}).Display(File);

const Total = async (
	By: string,
	URL = "GET /repos/{owner}/{repo}/git/trees/{tree_sha}",
) =>
	await Request(
		URL,
		{
			owner: User,
			repo: Repository,
			tree_sha: By,
			recursive: true,
		},
		// biome-ignore lint/suspicious/noExplicitAny:
		Object.assign((RESPONSE: any) => RESPONSE?.tree?.length ?? 0, {
			Key: `${URL}.RESPONSE.tree.length`,
		}),
	);

// TODO: WHEN TAG CHOOSE TAG <-> TAG FILE TOTAL
const File = async (
	By: string,
	URL = "GET /repos/{owner}/{repo}/commits/{ref}",
) =>
	await Request(
		URL,
		{
			owner: User,
			repo: Repository,
			ref: By,
		},
		// biome-ignore lint/suspicious/noExplicitAny:
		Object.assign((RESPONSE: any) => RESPONSE?.files?.length ?? 0, {
			Key: `${URL}.RESPONSE.files.length`,
		}),
	);

// biome-ignore lint/suspicious/noExplicitAny:
let Tag: any[] = [];

for (let Page = 1; Page <= 5; Page++) {
	try {
		const URL = "GET /repos/{owner}/{repo}/tags";

		Tag = Tag.concat(
			(
				await Request(
					URL,
					{
						owner: User,
						repo: Repository,
						per_page: 100,
						page: Page,
					},
					Object.assign(
						// biome-ignore lint/suspicious/noExplicitAny:
						// biome-ignore lint/complexity/noBannedTypes:
						async (RESPONSE: any): Promise<{} | any[]> =>
							(
								await import("@Function/Table/Layout/Unwrap.js")
							).default(
								await Promise.allSettled(
									// biome-ignore lint/suspicious/noExplicitAny:
									RESPONSE?.map(async (TAG: any) => ({
										Author: await (async (
											SHA: string,
											URL = "GET /repos/{owner}/{repo}/commits/{ref}",
										) =>
											await Request(
												URL,
												{
													owner: User,
													repo: Repository,
													ref: SHA,
												},
												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit?.author
															?.name ?? "",
													{
														Key: `${URL}.RESPONSE.commit.author.name`,
													},
												),
											))(TAG?.commit?.sha),
										Date: await (async (
											SHA: string,
											URL = "GET /repos/{owner}/{repo}/commits/{ref}",
										) =>
											await Request(
												URL,
												{
													owner: User,
													repo: Repository,
													ref: SHA,
												},
												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit?.author
															?.date ?? "",
													{
														Key: `${URL}.RESPONSE.commit.author.date`,
													},
												),
											))(TAG?.commit?.sha),
										File: await (async (SHA: string) => {
											const _Total = await Total(SHA);

											const _File = await File(SHA);

											return [
												await Dot(_Total, _File),
												_Total,
												_File,
											];
										})(TAG?.commit?.sha),
										Message: await (async (
											SHA: string,
											URL = "GET /repos/{owner}/{repo}/commits/{ref}",
										) =>
											await Request(
												URL,
												{
													owner: User,
													repo: Repository,
													ref: SHA,
												},
												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit
															?.message ?? "",
													{
														Key: `${URL}.RESPONSE.commit.message`,
													},
												),
											))(TAG?.commit?.sha),
										Name: TAG?.name ?? "",
										SHA: TAG?.commit?.sha ?? "",
									})),
								),
							),
						{
							Key: `${URL}.RESPONSE.map(Author,Date,File,Message,Name,SHA)`,
						},
					),
				)
			).filter((Data: null): boolean => Data !== null),
		);
	} catch (_Error) {
		console.log(_Error);
	}
}

Tag = Array.from(
	// biome-ignore lint/suspicious/noExplicitAny:
	new Map(Tag.map((Tag): [any, any] => [Tag.SHA, Tag])).values(),
);

const TagURL = `Cache/Tag/${Repository}-${User}-${SHA}.json`;

await (
	await import("node:fs/promises")
).writeFile(
	`${On ? "Public" : "Target"}/${TagURL}`,
	JSON.stringify(Tag, null, "\t"),
);

// biome-ignore lint/suspicious/noExplicitAny:
let Commit: any[] = [];

for (let Page = 1; Page <= 5; Page++) {
	try {
		const URL = "GET /repos/{owner}/{repo}/commits";

		Commit = Commit.concat(
			(
				await Request(
					URL,
					{
						owner: User,
						repo: Repository,
						per_page: 100,
						page: Page,
					},
					Object.assign(
						// biome-ignore lint/suspicious/noExplicitAny:
						async (RESPONSE: any) =>
							(
								await import("@Function/Table/Layout/Unwrap.js")
							).default(
								await Promise.allSettled(
									// biome-ignore lint/suspicious/noExplicitAny:
									RESPONSE?.map(async (COMMIT: any) => ({
										Author:
											COMMIT?.commit?.author?.name ?? "",
										Date:
											COMMIT?.commit?.author?.date ?? "",
										File: await (async (SHA: string) => {
											const _Total = await Total(SHA);

											const _File = await File(SHA);

											return [
												await Dot(_Total, _File),
												_Total,
												_File,
											];
										})(COMMIT?.sha),
										Message: COMMIT?.commit?.message ?? "",
										SHA: COMMIT?.sha ?? "",
									})),
								),
							),
						{
							Key: `${URL}.RESPONSE.map(Author,Date,File,Message,SHA)`,
						},
					),
				)
			).filter((Data: null) => Data !== null),
		);
	} catch (_Error) {
		console.log(_Error);
	}
}

Commit = Array.from(
	new Map(Commit.map((Commit) => [Commit.SHA, Commit])).values(),
);

const CommitURL = `Cache/Commit/${Repository}-${User}-${SHA}.json`;

await (
	await import("node:fs/promises")
).writeFile(
	`${On ? "Public" : "Target"}/${CommitURL}`,
	JSON.stringify(Commit, null, "\t"),
);
---

<status-table
	data-commit={CommitURL}
	data-repository={Repository}
	data-tag={TagURL}
	data-user={User}
	data-uuid={(await import("@Function/Table/Layout/UUID.js")).default()}>
	<table class="cell-border compact"></table>
</status-table>

<script>
	import "@Function/Table/Layout/Code.js";
</script>
