---
import type { CACHE_VERSION_SHA } from "astro:env/server";

export const On = process.env["NODE_ENV"] === "development";

const CACHE_SHA = (await import("astro:env/server")).getSecret(
	"CACHE_VERSION_SHA",
) as typeof CACHE_VERSION_SHA;

const { default: Request } = await import("@Function/Table/Layout/Request.js");

const { User, Repository } = Astro.props;

const Dot = async (Total: number, File: number) =>
	new (await import("@Function/Table/Layout/Dot.js")).default({
		Total,
	}).Display(File);

const Total = async (
	By: string,

	URL = "GET /repos/{owner}/{repo}/git/trees/{tree_sha}",
) =>
	await Request(
		URL,

		{
			owner: User,

			repo: Repository,

			tree_sha: By,

			recursive: true,
		},

		// biome-ignore lint/suspicious/noExplicitAny:
		Object.assign((RESPONSE: any) => RESPONSE?.tree?.length ?? 0, {
			Key: `${URL}.RESPONSE.tree.length`,
		}),
	);

// TODO: WHEN TAG CHOOSE TAG <-> TAG FILE TOTAL
const File = async (
	By: string,

	URL = "GET /repos/{owner}/{repo}/commits/{ref}",
) =>
	await Request(
		URL,

		{
			owner: User,

			repo: Repository,

			ref: By,
		},

		// biome-ignore lint/suspicious/noExplicitAny:
		Object.assign((RESPONSE: any) => RESPONSE?.files?.length ?? 0, {
			Key: `${URL}.RESPONSE.files.length`,
		}),
	);

// biome-ignore lint/suspicious/noExplicitAny:
let Tag: any[] = [];

for (let Page = 1; Page <= 5; Page++) {
	try {
		const URL = "GET /repos/{owner}/{repo}/tags";

		Tag = Tag.concat(
			(
				await Request(
					URL,

					{
						owner: User,

						repo: Repository,

						per_page: 100,

						page: Page,
					},

					Object.assign(
						// biome-ignore lint/suspicious/noExplicitAny:
						// biome-ignore lint/complexity/noBannedTypes:
						async (RESPONSE: any): Promise<{} | any[]> =>
							(
								await import("@Function/Table/Layout/Unwrap.js")
							).default(
								await Promise.allSettled(
									// biome-ignore lint/suspicious/noExplicitAny:
									RESPONSE?.map(async (TAG: any) => {
										const SHA_COMMIT_TAG = TAG?.commit?.sha;

										if (!SHA_COMMIT_TAG) {
											return null;
										}

										return {
											Author: await Request(
												"GET /repos/{owner}/{repo}/commits/{ref}",

												{
													owner: User,

													repo: Repository,

													ref: SHA_COMMIT_TAG,
												},

												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit?.author
															?.name ?? "",

													{
														Key: `commit.author.name.${SHA_COMMIT_TAG}`,
													},
												),
											),

											Date: await Request(
												"GET /repos/{owner}/{repo}/commits/{ref}",

												{
													owner: User,

													repo: Repository,

													ref: SHA_COMMIT_TAG,
												},

												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit?.author
															?.date ?? "",

													{
														Key: `${URL}.RESPONSE.commit.author.date`,
													},
												),
											),

											File: await (async (
												SHA: string,
											) => {
												const _Total = await Total(SHA);

												const _File = await File(SHA);

												return [
													await Dot(_Total, _File),

													_Total,

													_File,
												];
											})(SHA_COMMIT_TAG),

											Message: await Request(
												"GET /repos/{owner}/{repo}/commits/{ref}",

												{
													owner: User,

													repo: Repository,

													ref: SHA_COMMIT_TAG,
												},

												Object.assign(
													// biome-ignore lint/suspicious/noExplicitAny:
													(RESPONSE: any) =>
														RESPONSE?.commit
															?.message ?? "",

													{
														Key: `${URL}.RESPONSE.commit.message`,
													},
												),
											),

											Name: TAG?.name ?? "",

											SHA: SHA_COMMIT_TAG,
										};
									}) ?? [],
								),
							),

						{
							Key: `${URL}.RESPONSE.map(Author,Date,File,Message,Name,SHA)`,
						},
					),
				)
			).filter((Data: null | object): boolean => Data !== null),
		);
	} catch (_Error) {
		console.error(`Error fetching tags page ${Page}:`, _Error);
	}
}

Tag = Array.from(
	new Map(
		// biome-ignore lint/suspicious/noExplicitAny:
		Tag.map((Tag: any): [any, any] => [Tag.SHA, Tag]),
	).values(),
);

const TagURL = `Cache/Tag/${Repository}-${User}-${CACHE_SHA}.json`;

try {
	await (
		await import("node:fs/promises")
	).writeFile(
		`${On ? "Public" : "Target"}/${TagURL}`,

		JSON.stringify(Tag, null, "\t"),
	);
} catch (_Error) {}

// biome-ignore lint/suspicious/noExplicitAny:
let Commit: any[] = [];

for (let Page = 1; Page <= 5; Page++) {
	try {
		const URL = "GET /repos/{owner}/{repo}/commits";

		Commit = Commit.concat(
			(
				await Request(
					URL,

					{
						owner: User,

						repo: Repository,

						per_page: 100,

						page: Page,
					},

					Object.assign(
						// biome-ignore lint/suspicious/noExplicitAny:
						async (RESPONSE: any) =>
							(
								await import("@Function/Table/Layout/Unwrap.js")
							).default(
								await Promise.allSettled(
									// biome-ignore lint/suspicious/noExplicitAny:
									RESPONSE?.map(async (COMMIT: any) => ({
										Author:
											COMMIT?.commit?.author?.name ?? "",

										Date:
											COMMIT?.commit?.author?.date ?? "",

										File: await (async (SHA: string) => {
											const _Total = await Total(SHA);

											const _File = await File(SHA);

											return [
												await Dot(_Total, _File),

												_Total,

												_File,
											];
										})(COMMIT?.sha),

										Message: COMMIT?.commit?.message ?? "",

										SHA: COMMIT?.sha ?? "",
									})) ?? [],
								),
							),

						{
							Key: `${URL}.RESPONSE.map(Author,Date,File,Message,SHA)`,
						},
					),
				)
			).filter((Data: null | object) => Data !== null),
		);
	} catch (_Error) {
		console.error(`Error fetching commits page ${Page}:`, _Error);
	}
}

Commit = Array.from(
	// biome-ignore lint/suspicious/noExplicitAny:
	new Map(Commit.map((Commit: any) => [Commit.SHA, Commit])).values(),
);

const CommitURL = `Cache/Commit/${Repository}-${User}-${CACHE_SHA}.json`;

try {
	await (
		await import("node:fs/promises")
	).writeFile(
		`${On ? "Public" : "Target"}/${CommitURL}`,

		JSON.stringify(Commit, null, "\t"),
	);
} catch (_Error) {}
---

<status-table
	data-commit={CommitURL}
	data-repository={Repository}
	data-tag={TagURL}
	data-user={User}
	data-uuid={(await import("@Function/Table/Layout/UUID.js")).default()}>
	<table class="cell-border compact"></table>
</status-table>

<script>
	import "@Function/Table/Layout/Code.js";
</script>
