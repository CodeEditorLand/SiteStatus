---
import "@Function/Commit/Stylesheet.css";
import "datatables.net-dt/css/dataTables.dataTables.css";

const { default: Request } = await import("@Function/Commit/Layout/Request.js");

const { User, Repository } = Astro.props;

let Last: any[] = [];

for (let Page = 0; Page < 5; Page++) {
	Last = Last.concat(
		await Request("GET /repos/{owner}/{repo}/commits", {
			owner: User,

			repo: Repository,

			per_page: 100,

			page: Page,
		}),
	);
}

Last = await Promise.allSettled(
	Last.map(async (Commit: any) => ({
		"Author": Commit["commit"]["author"]["name"] ?? "",

		"Commit Message": Commit["message"] ?? "",

		"Date": Commit["commit"]["author"]["date"] ?? "",

		"HREF": Commit["html_url"] ?? "",

		"SHA": Commit["sha"] ?? "",

		"File": await (async (SHA: string) => {
			const Total = (
				await Request(
					"GET /repos/{owner}/{repo}/git/trees/{tree_sha}",

					{
						owner: User,

						repo: Repository,

						tree_sha: SHA,

						recursive: true,
					},
				)
			).tree.length;

			const File = (
				await Request("GET /repos/{owner}/{repo}/commits/{ref}", {
					owner: User,

					repo: Repository,

					ref: SHA,
				})
			).files;

			return [
				new (await import("@Function/Commit/Layout/Dot.js")).default({
					Total,
				}).Display(File.length),

				Total,

				File.length,
			];
		})(Commit["sha"]),
	})),
);

const UUID = (await import("@Function/Commit/Layout/UUID.js")).default();

interface Props {
	User?: string;

	Repository?: string;
}

const Unwrap = (_Array: any[]): any[] | {} => {
	if (Array.isArray(_Array)) {
		return _Array.map(Unwrap);
	}

	if (_Array && typeof _Array === "object") {
		const Key = Object.keys(_Array);

		if (
			Key.length === 2 &&
			Key.includes("status") &&
			Key.includes("value")
		) {
			// @ts-expect-error
			return Unwrap(_Array.value);
		}

		const Return = {};

		// @ts-expect-error
		for (let Key in _Array) {
			// @ts-expect-error
			Return[Key] = Unwrap(_Array[Key]);
		}

		return Return;
	}

	return _Array;
};

Last = Unwrap(Last) as any[];
---

<commit-table
	class="Table"
	data-uuid={UUID}
	data-user={User}
	data-repo={Repository}>
	<div class="Touch">
		<div class="Progress"></div>
	</div>

	<table class="cell-border compact"></table>
</commit-table>

<script define:vars={{ Last, UUID }}>
	// @ts-ignore
	window[UUID] = Last;
</script>

<script>
	import "@Function/Commit/Layout/Code.js";
</script>
