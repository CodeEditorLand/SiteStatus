---
import "@Function/Commit/Stylesheet.css";
import "datatables.net-dt/css/dataTables.dataTables.css";

const { default: Request } = await import("@Function/Commit/Layout/Request.js");

const { User, Repository } = Astro.props;

let Last: any[] = [];

for (let Page = 0; Page < 5; Page++) {
	try {
		Last = Last.concat(
			await Request("GET /repos/{owner}/{repo}/commits", {
				owner: User,

				repo: Repository,

				per_page: 100,

				page: Page,
			}),
		);
	} catch (_Error) {
		console.log(_Error);
	}
}

Last = (await import("@Function/Commit/Layout/Unwrap.js")).default(
	await Promise.allSettled(
		Last.map(async (Commit: any) => ({
			"Author": Commit["commit"]["author"]["name"] ?? "",

			"Message": Commit["message"] ?? "",

			"Date": Commit["commit"]["author"]["date"] ?? "",

			"SHA": Commit["sha"] ?? "",

			"File": await (async (SHA: string) => {
				try {
					const Total =
						(
							await Request(
								"GET /repos/{owner}/{repo}/git/trees/{tree_sha}",

								{
									owner: User,

									repo: Repository,

									tree_sha: SHA,

									recursive: true,
								},
							)
						)?.tree?.length ?? 0;

					const File =
						(
							await Request(
								"GET /repos/{owner}/{repo}/commits/{ref}",
								{
									owner: User,

									repo: Repository,

									ref: SHA,
								},
							)
						)?.files ?? 0;

					return [
						new (
							await import("@Function/Commit/Layout/Dot.js")
						).default({
							Total,
						}).Display(File.length),

						Total,

						File.length,
					];
				} catch (_Error) {
					console.log(_Error);

					return ["", 0, 0];
				}
			})(Commit["sha"]),
		})),
	),
) as any[];

const UUID = (await import("@Function/Commit/Layout/UUID.js")).default();
---

<commit-table
	class="Table"
	data-repository={Repository}
	data-user={User}
	data-uuid={UUID}>
	<div class="Touch">
		<div class="Progress"></div>
	</div>

	<table class="cell-border compact"></table>
</commit-table>

<script define:vars={{ Last, UUID }}>
	// @ts-ignore
	window[UUID] = Last;
</script>

<script>
	import "@Function/Commit/Layout/Code.js";
</script>
