---
import "@Function/Commit/Stylesheet.css";
import "datatables.net-dt/css/dataTables.dataTables.css";

const { default: Request } = await import(
	"@Function/Commit/Octokit/Request.js"
);

const { user, repo } = Astro.props;

let Last = await Request("GET /repos/{owner}/{repo}/commits", {
	owner: user,
	repo,
	per_page: 50,
});

Last = await Promise.all(
	Last.map(async (Commit: any) => ({
		"Author": Commit["commit"]["author"]["name"] ?? "",
		"Commit Message": Commit["message"] ?? "",
		"Date": Commit["commit"]["author"]["date"] ?? "",
		"HREF": Commit["html_url"] ?? "",
		"SHA": Commit["sha"] ?? "",
		"File": await (async (SHA: string) => {
			const Total = (
				await Request(
					"GET /repos/{owner}/{repo}/git/trees/{tree_sha}",
					{
						owner: user,
						repo,
						tree_sha: SHA,
						recursive: true,
					},
				)
			).tree.length;

			const File = (
				await Request("GET /repos/{owner}/{repo}/commits/{ref}", {
					owner: user,
					repo,
					ref: SHA,
				})
			).files;

			return [
				new (await import("@Function/Commit/Dot.js")).default({
					Total,
				}).Display(File.length),
				Total,
				File.length,
			];
		})(Commit["sha"]),
	})),
);

const UUID = (await import("@Function/UUID/Fn.js")).default();
---

<commit-table data-uuid={UUID} class="Table">
	<div class="Touch">
		<div class="Progress"></div>
	</div>

	<table class="cell-border compact"></table>
</commit-table>

<script define:vars={{ Last, UUID }}>
	// @ts-ignore
	window[UUID] = Last;
</script>

<script>
	import DataTable from "datatables.net-dt";

	export const HighLight = (
		Container: HTMLElement,
		Search: string,
		HighLight = "HighLight",
	) => {
		Container.querySelectorAll<HTMLSpanElement>(
			`span.${HighLight}`,
		).forEach((Span) => (Span.outerHTML = Span.textContent ?? ""));

		if (!Container || !Search) {
			return;
		}

		Container.innerHTML = Container.innerHTML.replace(
			new RegExp(Search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi"),
			(Match: string) => `<span class="${HighLight}">${Match}</span>`,
		);
	};

	export const Segment = (Total: number, Element: HTMLDivElement) => {
		Element.innerHTML = "";

		for (let i = 0; i < Total; i++) {
			const Segment = document.createElement("div");

			Segment.classList.add("Segment");

			Element.appendChild(Segment);
		}
	};

	export const Progress = (
		Current: number,
		_Total: number,
		Element: HTMLDivElement,
	) => {
		const _Segment = Element.querySelectorAll(".Segment");

		_Segment.forEach((Segment, Index) =>
			Index < Current + 1
				? Segment.classList.add("Completed")
				: Segment.classList.remove("Completed"),
		);

		// Element.style.width = ((Current + 1) / Total) * 100 + "%";
	};

	document.addEventListener("DOMContentLoaded", () => {
		const Theme = () =>
			document
				.querySelector("html")
				?.classList.toggle(
					"dark",
					window.matchMedia("(prefers-color-scheme: dark)").matches,
				);

		window
			.matchMedia("(prefers-color-scheme: dark)")
			.addEventListener("change", Theme);

		Theme();

		class Commit extends HTMLElement {
			connectedCallback() {
				const UUID = this.dataset["uuid"] ?? "";

				new DataTable(`[data-uuid="${UUID}"] table`, {
					columns: [
						{
							title: "DATE",
							render: (Text) =>
								`<span class="Text">${new Date(Text).toLocaleDateString()} 📅</span>`,
							data: (Row) => new Date(Row.Date).getTime(),
							type: "numeric",
						},
						{
							title: "FILE",
							render: (_, __, Row) =>
								`<span class="Text File" title="File: ${Row.File[2]} / ${Row.File[1]}">${Row.File[0]}</span>`,
							data: (Row) => Row.File[1],
							type: "numeric",
						},
						{
							title: "COMMIT MESSAGE",
							data: "Commit Message",
							render: (Text) =>
								`<span class="Text">${Text.trim() === "" || Text.trim().length === 0 ? "No Commit Message 😶" : `${Text.trim()} 🗣️`}</span>`,
						},
						{
							title: "HREF",
							render: (_, __, Row) => `<a class="Pulse" \
									href="${Row.HREF}" \
									rel="noopener noreferrer" \
									target="_blank"> \
										<span class="Text">@COMMIT_</span><span class="Text SHA">${Row.SHA} 🔗</span> \
									</a>`,
							data: (Row) => `@COMMIT_${Row.SHA}`,
						},
						{
							title: "AUTHOR",
							data: "Author",
							render: (Text) =>
								`<span class="Text">${Text} ✍️</span>`,
						},
					],
					// @ts-expect-error
					data: window[UUID],
					responsive: true,
					paging: true,
					scrollCollapse: true,
					scrollY: "1000px",
					processing: true,
					order: [[2, "desc"]],
					drawCallback: (Setting) =>
						Setting["oPreviousSearch"]["search"]
							.split("_")
							.forEach((_Element: string) =>
								document
									.querySelectorAll<HTMLSpanElement>(
										`#${Setting["sInstance"]} .Text`,
									)
									.forEach((Element) =>
										HighLight(Element, _Element),
									),
							),
					initComplete(Setting) {
						const Touch = document.querySelector<HTMLDivElement>(
							`[data-uuid="${UUID}"] .Touch`,
						);

						const _Progress = Touch?.querySelector<HTMLDivElement>(
							`.Progress`,
						) as HTMLDivElement;

						const Api = () => Setting["oInstance"].api();

						const Info = () => Api().page.info();

						Segment(Info().pages, _Progress);

						Progress(Info().page, Info().pages, _Progress);

						Touch?.addEventListener("mousemove", (e) => {
							const Target = Math.floor(
								(e.offsetX / Touch.offsetWidth) * Info().pages,
							);

							if (Target !== Info().page) {
								Api().page(Target).draw(false);

								Progress(Target, Info().pages, _Progress);
							}
						});
					},
				});
			}
		}

		customElements.define("commit-table", Commit);
	});
</script>
