---
import "datatables.net-dt/css/dataTables.dataTables.css";

import type { CF_PAGES_COMMIT_SHA } from "astro:env/server";

export const On = process.env["NODE_ENV"] === "development";

const SHA = (await import("astro:env/server")).getSecret(
	"CF_PAGES_COMMIT_SHA",
) as typeof CF_PAGES_COMMIT_SHA;

const { default: Request } = await import("@Function/Commit/Layout/Request.js");

const { User, Repository } = Astro.props;

let Last: any[] = [];

for (let Page = 1; Page <= 5; Page++) {
	try {
		Last = Last.concat(
			(
				await Request(
					"GET /repos/{owner}/{repo}/commits",

					{
						owner: User,

						repo: Repository,

						per_page: 100,

						page: Page,
					},

					async (RESPONSE) =>
						(
							await import("@Function/Commit/Layout/Unwrap.js")
						).default(
							await Promise.allSettled(
								RESPONSE?.map(async (COMMIT: any) => ({
									Author: COMMIT?.commit?.author?.name ?? "",

									Date: COMMIT?.commit?.author?.date ?? "",

									Message: COMMIT?.commit?.message ?? "",

									SHA: COMMIT?.sha ?? "",

									File: await (async (SHA: string) => {
										try {
											const Total = await Request(
												"GET /repos/{owner}/{repo}/git/trees/{tree_sha}",

												{
													owner: User,

													repo: Repository,

													tree_sha: SHA,

													recursive: true,
												},

												(Response) =>
													Response?.tree?.length ?? 0,
											);

											const File = await Request(
												"GET /repos/{owner}/{repo}/commits/{ref}",

												{
													owner: User,

													repo: Repository,

													ref: SHA,
												},

												(Response) =>
													Response?.files?.length ??
													0,
											);

											return [
												new (
													await import(
														"@Function/Commit/Layout/Dot.js"
													)
												).default({
													Total,
												}).Display(File),

												Total,

												File,
											];
										} catch (_Error) {}

										return ["", 0, 0];
									})(COMMIT?.sha),
								})),
							),
						),
				)
			).filter((Data: null) => Data !== null),
		);
	} catch (_Error) {}
}

Last = Array.from(new Map(Last.map((Commit) => [Commit.SHA, Commit])).values());

const URL = `Cache/Commit/${Repository}-${User}-${SHA}.json`;

await (
	await import("fs/promises")
).writeFile(
	`${On ? "Public" : "Target"}/${URL}`,
	JSON.stringify(Last, null, "\t"),
);
---

<Commit
	data-repository={Repository}
	data-user={User}
	data-uuid={(await import("@Function/Commit/Layout/UUID.js")).default()}
	data-ajax={URL}>
	<table class="cell-border compact"></table>
</Commit>

<script>
	import "@Function/Commit/Layout/Code.js";
</script>
