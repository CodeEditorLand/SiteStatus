---
import "@Function/Commit/Stylesheet.css";
import "datatables.net-dt/css/dataTables.dataTables.css";

const { default: Request } = await import(
	"@Function/Commit/Octokit/Request.js"
);

const { user, repo } = Astro.props;

let Last = await Request("GET /repos/{owner}/{repo}/commits", {
	owner: user,
	repo,
	per_page: 50,
});

Last = await Promise.all(
	Last.map(async (Commit: any) => ({
		"Author": Commit["commit"]["author"]["name"] ?? "",
		"Commit Message": Commit["message"] ?? "",
		"Date": Commit["commit"]["author"]["date"] ?? "",
		"HREF": Commit["html_url"] ?? "",
		"SHA": Commit["sha"] ?? "",
		"File": await (async (SHA: string) => {
			const Total = (
				await Request(
					"GET /repos/{owner}/{repo}/git/trees/{tree_sha}",
					{
						owner: user,
						repo,
						tree_sha: SHA,
						recursive: true,
					},
				)
			).tree.length;

			const File = (
				await Request("GET /repos/{owner}/{repo}/commits/{ref}", {
					owner: user,
					repo,
					ref: SHA,
				})
			).files;

			return [
				new (await import("@Function/Commit/Dot.js")).default({
					Total,
				}).Display(File.length),
				Total,
				File.length,
			];
		})(Commit["sha"]),
	})),
);

const UUID = (await import("@Function/UUID/Fn.js")).default();
---

<commit-table data-uuid={UUID}>
	<table class="cell-border compact"></table>
</commit-table>

<style is:global>
	div.dt-container select.dt-input {
		@apply cursor-pointer;
		padding-left: 2.5rem !important;
		background-position: left 0.5rem center;
	}

	table.dataTable
		thead
		> tr
		> th.dt-orderable-asc
		span.dt-column-order:before,
	table.dataTable thead > tr > th.dt-ordering-asc span.dt-column-order:before,
	table.dataTable
		thead
		> tr
		> td.dt-orderable-asc
		span.dt-column-order:before,
	table.dataTable thead > tr > td.dt-ordering-asc span.dt-column-order:before,
	table.dataTable
		thead
		> tr
		> th.dt-orderable-desc
		span.dt-column-order:after,
	table.dataTable thead > tr > th.dt-ordering-desc span.dt-column-order:after,
	table.dataTable
		thead
		> tr
		> td.dt-orderable-desc
		span.dt-column-order:after,
	table.dataTable
		thead
		> tr
		> td.dt-ordering-desc
		span.dt-column-order:after {
		content: "●";
		content: "●"/"";
	}

	.HighLight {
		@apply relative font-bold text-amber-700;
	}

	.HighLight::before {
		@apply absolute -z-10 block bg-amber-400;
		content: "";
		inset: -0.1rem -0.11rem;
	}

	html.dark table.dataTable.cell-border > tbody > tr > td,
	html.dark table.dataTable.cell-border > tbody > tr > th,
	table.dataTable.cell-border > tbody > tr > * {
		border-top-width: 2px;
		border-right-width: 2px;
	}

	html.dark table.dataTable.cell-border > tbody > tr > td:first-child,
	html.dark table.dataTable.cell-border > tbody > tr > th:first-child {
		border-left-width: 2px;
	}

	html.dark .dt-container.dt-empty-footer table.dataTable {
		border-bottom-width: 2px;
	}
</style>

<script define:vars={{ Last, UUID }}>
	// @ts-ignore
	window[UUID] = Last;
</script>

<script>
	import DataTable from "datatables.net-dt";

	export const HighLight = (
		Container: HTMLElement,
		Search: string,
		HighLight = "HighLight",
	) => {
		Container.querySelectorAll<HTMLSpanElement>(
			`span.${HighLight}`,
		).forEach((Span) => (Span.outerHTML = Span.textContent ?? ""));

		if (!Container || !Search) {
			return;
		}

		Container.innerHTML = Container.innerHTML.replace(
			new RegExp(Search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi"),
			(Match: string) => `<span class="${HighLight}">${Match}</span>`,
		);
	};

	document.addEventListener("DOMContentLoaded", () => {
		const Theme = () =>
			document
				.querySelector("html")
				?.classList.toggle(
					"dark",
					window.matchMedia("(prefers-color-scheme: dark)").matches,
				);

		window
			.matchMedia("(prefers-color-scheme: dark)")
			.addEventListener("change", Theme);

		Theme();

		class Commit extends HTMLElement {
			connectedCallback() {
				const UUID = this.dataset["uuid"] ?? "";

				new DataTable(`[data-uuid=${UUID}] table`, {
					columns: [
						{
							title: "DATE",
							render: (Text) =>
								`<span class="Text">${new Date(Text).toLocaleDateString()} 📅</span>`,
							data: (Row) => new Date(Row.Date).getTime(),
							type: "numeric",
						},
						{
							title: "FILE",
							render: (_Text, _Type, Row) =>
								`<span class="text-right Text font-Hack cursor-pointer text-2xl tracking-[-.25em]" title="File: ${Row.File[2]} / ${Row.File[1]}">${Row.File[0]}</span>`,
							data: (Row) => Row.File[1],
							type: "numeric",
						},
						{
							title: "COMMIT MESSAGE",
							data: "Commit Message",
							render: (Text) =>
								`<span class="Text">${Text.trim() === "" || Text.trim().length === 0 ? "No Commit Message 😶" : `${Text.trim()} 🗣️`}</span>`,
						},
						{
							title: "HREF",
							render: (
								_Text,
								_Type,
								Row,
							) => `<a class="font-medium text-violet-200 dark:text-violet-200 Pulse" \
									href="${Row.HREF}" \
									rel="noopener noreferrer" \
									target="_blank"> \
										<span class="Text">@COMMIT_</span><span class="tabular-nums uppercase font-Hack Text">${Row.SHA} 🔗</span> \
									</a>`,
							data: (Row) => `@COMMIT_${Row.SHA}`,
						},
						{
							title: "AUTHOR",
							data: "Author",
							render: (Text) =>
								`<span class="Text">${Text} ✍️</span>`,
						},
					],
					// @ts-expect-error
					data: window[UUID],
					responsive: true,
					paging: true,
					scrollCollapse: true,
					scrollY: "1000px",
					processing: true,
					order: [[2, "desc"]],
					drawCallback: (Internal) =>
						Internal["oPreviousSearch"]["search"]
							.split("_")
							.forEach((El: string) =>
								document
									.querySelectorAll<HTMLSpanElement>(
										`#${Internal["sInstance"]} .Text`,
									)
									.forEach((Element) =>
										HighLight(Element, El),
									),
							),
				});
			}
		}

		customElements.define("commit-table", Commit);
	});
</script>
