---
import Analytic from "@Function/Analytic/Layout.astro";
import Table from "@Function/Table/Layout.astro";
import Base from "@Layout/Base.astro";
---

<Base>
	<link
		slot="Head"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/hack-font@3.3.0/build/web/hack-subset.css"
	/>

	<!-- Main -->

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Common" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Echo" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Vine" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Mountain" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Rest" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Output" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Cocoon" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Wind" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Worker" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Sky" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Mist" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Maintain" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Grove" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Land" />
	</div>

	<!-- Dependency Related or Submodules -->

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Element" />
	</div>

	<div class="m-2 p-2">
		<Table User="CodeEditorLand" Repository="Dependency" />
	</div>

	<!-- Analytic -->

	<Analytic
		Key="XD_rfRlLlZ_XPiBZudFxnHQA-F6zbg"
		Title="Boot & Startup Performance"
	/>

	<Analytic
		Key="TQTeVG6-hxfGbY6wLUrVIVk-oQZVyQ"
		Title="Cocoon & Build Pipeline"
	/>

	<Analytic
		Key="3lPmrM4Nh7W_VevgHwDiqf0x9x4kxA"
		Title="Errors & Reliability"
	/>

	<Analytic
		Key="pkvU8a-RU8JltbX8SJ55ygmxdmmo4A"
		Title="Feature Parity & Mountain Migration"
	/>

	<Analytic
		Key="UsRKs-LnLgIskd2fdCkhIKj0czQX9A"
		Title="IPC & Telemetry Throughput"
	/>

	<Analytic Key="pZTmriMAj_NPFNAvaaB1EncaiFlvVA" Title="Land Editor Debug" />
</Base>
