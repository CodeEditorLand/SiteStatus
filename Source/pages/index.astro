---
import Commit from "@Function/Commit/Layout.astro";
import Base from "@Layout/Base.astro";
---

<Base>
	<link
		slot="Head"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/hack-font@3.3.0/build/web/hack-subset.css"
	/>

	<div class="m-2 p-2">
		<h1 class="mb-2 text-2xl font-bold text-stone-900 dark:text-white">
			Last
		</h1>

		<h2 class="mb-4 text-lg text-stone-700 dark:text-stone-400">
			CodeEditorLand/Land
		</h2>

		<!-- TODO: CONVERT THIS TO PAGE / ENDPOINT and only output the Render here -->
		<Commit user="CodeEditorLand" repo="Land" />
	</div>

	<div class="m-2 p-2">
		<h1 class="mb-2 text-2xl font-bold text-stone-900 dark:text-white">
			Last
		</h1>

		<h2 class="mb-4 text-lg text-stone-700 dark:text-stone-400">
			CodeEditorLand/Dependency
		</h2>

		<Commit user="CodeEditorLand" repo="Dependency" />
	</div>

	<div class="m-2 p-2">
		<h1 class="mb-2 text-2xl font-bold text-stone-900 dark:text-white">
			Last
		</h1>

		<h2 class="mb-4 text-lg text-stone-700 dark:text-stone-400">
			CodeEditorLand/Element
		</h2>

		<Commit user="CodeEditorLand" repo="Element" />
	</div>
</Base>
